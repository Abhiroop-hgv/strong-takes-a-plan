# ---- Site ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Secret used to sign cancel / delete-my-data links (any long random string)
SESSION_SECRET=change-me-to-a-long-random-string

# ---- Booking mode ----
# test  = no external calls. Bookings go to .data/bookings.json, emails are written to .data/outbox/
# live  = real Postgres + Resend (+ WhatsApp if enabled)
BOOKING_MODE=test

# ---- Coach schedule (see src/lib/config.ts for hours, days off, buffers) ----
COACH_TIMEZONE=Asia/Kolkata
COACH_EMAIL=coach@example.com
# Video link put in the calendar event / emails (Google Meet, Zoom, Cal Video ...)
MEETING_URL=https://meet.example.com/your-room

# ---- Health data encryption (required in live mode) ----
# 32 random bytes, base64:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
HEALTH_DATA_KEY=

# ---- Database (live mode) ----
DATABASE_URL=

# ---- Email (live mode) ----
RESEND_API_KEY=
EMAIL_FROM="Coach <bookings@yourdomain.com>"

# ---- WhatsApp Business Cloud API (optional) ----
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=booking_confirmation
WHATSAPP_TEMPLATE_LANG=en

# ---- Bot protection (optional, recommended in live mode) ----
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- Reminders: call GET /api/cron/reminders hourly with  Authorization: Bearer <CRON_SECRET> ----
CRON_SECRET=

# ---- Analytics (Plausible; leave empty to disable) ----
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
